{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "limit": 100,
        "name": "Annotations & Alerts",
        "showIn": 0,
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "resets(process_uptime_seconds{application=\"$application\"}[1m]) > 0",
        "hide": false,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "Pod Restart / Deploy",
        "showIn": 0,
        "step": "1m",
        "tagKeys": "restart-tag",
        "textFormat": "pod restarted (deploy or OOM)",
        "titleFormat": "Restart"
      }
    ]
  },
  "description": "JAVA_TOOL_OPTIONS(MaxRAMPercentage/SerialGC/MaxMetaspaceSize/Xss) 적용 전후 비교용. before 구간 부하테스트 -> 배포(Restart 주석 자동 표시) -> after 구간 같은 부하테스트 순으로 진행하면 한 타임라인에서 전후 비교 가능. HPA는 min=max=1로 고정한 상태에서 측정 권장(replica 수 변수 제거).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "Memory (container vs JVM heap)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "cAdvisor 기준 실제 컨테이너 메모리(working set). request/limit 라인과 같이 보면 여유폭 바로 확인 가능.",
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "request|limit" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 201,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "container_memory_working_set_bytes{namespace=\"groovy-kubernates\", pod=~\"$application.*\", container=\"$application\"}",
          "legendFormat": "working_set {{pod}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kube_pod_container_resource_requests{namespace=\"groovy-kubernates\", pod=~\"$application.*\", container=\"$application\", resource=\"memory\"}",
          "legendFormat": "request",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kube_pod_container_resource_limits{namespace=\"groovy-kubernates\", pod=~\"$application.*\", container=\"$application\", resource=\"memory\"}",
          "legendFormat": "limit",
          "refId": "C"
        }
      ],
      "title": "Container Memory (working set) vs request/limit",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "JVM 내부 관점 heap. MaxRAMPercentage 적용 후 max가 낮아지고, used가 그 안에서 안정적으로 도는지 확인.",
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 202,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_used_bytes{application=\"$application\", instance=\"$instance\", area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_committed_bytes{application=\"$application\", instance=\"$instance\", area=\"heap\"})",
          "legendFormat": "committed",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_max_bytes{application=\"$application\", instance=\"$instance\", area=\"heap\"})",
          "legendFormat": "max",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_used_bytes{application=\"$application\", instance=\"$instance\", area=\"nonheap\"})",
          "legendFormat": "nonheap used (metaspace 포함)",
          "refId": "D"
        }
      ],
      "title": "JVM Heap / Non-Heap",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 210,
      "title": "Throughput / Latency / Errors (test.py 부하 결과 확인용)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "test.py가 실제로 얼마나 처리했는지(초당 req). before/after 구간 높이 비교.",
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 10 },
      "id": 211,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\"}[1m]))",
          "legendFormat": "throughput",
          "refId": "A"
        }
      ],
      "title": "HTTP Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "percentiles-histogram 설정돼있어 histogram_quantile로 실측 p50/p95/p99. GC pause 늘면 여기 튀는 걸로 확인 가능.",
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 10 },
      "id": 212,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"$application\"}[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"$application\"}[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"$application\"}[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "HTTP Latency (p50/p95/p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "5xx 비율. 메모리 옵션 줄였다가 에러/타임아웃 늘면 여기서 바로 드러남.",
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 10 },
      "id": 213,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"$application\", status=~\"5..\"}[1m]))",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx Errors",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 220,
      "title": "GC / Threads (Xss, SerialGC 영향 확인용)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "SerialGC로 바꾸면 pause 빈도/시간 패턴이 G1과 달라짐. 여기서 전후 비교.",
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 18 },
      "id": 221,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{application=\"$application\", instance=\"$instance\"}[1m])) by (application, instance) / on(application, instance) system_cpu_count",
          "legendFormat": "CPU time on GC",
          "refId": "A"
        }
      ],
      "title": "GC Pressure",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "-Xss256k로 스레드 스택 줄인 효과는 여기 수치엔 안 잡히고 컨테이너 메모리 패널에서 간접 확인. 여긴 스레드 풀 자체가 죌였는지(server.tomcat.threads.max) 보는 용도.",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 18 },
      "id": 222,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "tomcat_threads_busy_threads{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "busy",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "tomcat_threads_current_threads{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "current",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "tomcat_threads_config_max_threads{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "max",
          "refId": "C"
        }
      ],
      "title": "Tomcat Threads",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 18 },
      "id": 223,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_live_threads{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "live",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_peak_threads{application=\"$application\", instance=\"$instance\"}",
          "legendFormat": "peak",
          "refId": "B"
        }
      ],
      "title": "JVM Threads",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 230,
      "title": "Stability (메모리 너무 줄여서 죽는지 확인)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "limit보다 낮춘 memory/heap 설정 탓에 OOMKilled/재시작 도는지 확인하는 최종 안전핀. 값 튀면(0 초과) 절대 이 설정으로 못 감.",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 30, "lineWidth": 1 } }, "overrides": [] },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 26 },
      "id": 231,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"groovy-kubernates\", pod=~\"$application.*\", container=\"$application\"}[5m])",
          "legendFormat": "restarts {{pod}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kube_pod_container_status_last_terminated_reason{namespace=\"groovy-kubernates\", pod=~\"$application.*\", container=\"$application\", reason=\"OOMKilled\"}",
          "legendFormat": "OOMKilled {{pod}}",
          "refId": "B"
        }
      ],
      "title": "Pod Restarts / OOMKilled",
      "type": "timeseries"
    }
  ],
